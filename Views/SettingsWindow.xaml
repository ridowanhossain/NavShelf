<Window x:Class="ExplorerBookmarkBar.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NavShelf Settings"
        Height="525" Width="475"
        WindowStartupLocation="Manual"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="CanMinimize"
        ShowInTaskbar="True">

    <Window.Resources>
        <!-- TitleBar Window Control Buttons -->
        <Style x:Key="TitleBarButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Width" Value="46" />
            <Setter Property="Height" Value="32" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="btnBorder" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="{DynamicResource ItemHoverBackground}" />
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="{DynamicResource ItemPressedBackground}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CloseButtonStyle" TargetType="Button" BasedOn="{StaticResource TitleBarButtonStyle}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="btnBorder" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="#E81123" />
                                <Setter Property="Foreground" Value="#FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="#C4101F" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Standard Button Styles -->
        <Style x:Key="FluentButton" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource SectionBg}" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
            <Setter Property="BorderBrush" Value="{DynamicResource DialogBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="12,5" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource ItemHoverBackground}" />
                                <Setter TargetName="border" Property="BorderBrush" Value="{DynamicResource ItemHoverBorder}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource ItemPressedBackground}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource AccentColor}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AccentColor}" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="Padding" Value="12,5" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource AccentHover}" />
                                <Setter TargetName="border" Property="BorderBrush" Value="{DynamicResource AccentHover}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.85" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="Slider">
            <Setter Property="Margin" Value="0,2,0,2" />
            <Setter Property="SmallChange" Value="1" />
            <Setter Property="LargeChange" Value="2" />
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Margin" Value="0,3,0,4" />
        </Style>
    </Window.Resources>

    <!-- Outer Window Container with Border and Scale/Fade Animation -->
    <Border x:Name="RootWindowBorder"
            Background="{DynamicResource DialogBg}"
            BorderBrush="{DynamicResource DialogBorder}"
            BorderThickness="1"
            CornerRadius="8"
            RenderTransformOrigin="0.5,0.5">

        <Border.RenderTransform>
            <ScaleTransform x:Name="WindowScale" ScaleX="0.94" ScaleY="0.94" />
        </Border.RenderTransform>

        <Border.Triggers>
            <EventTrigger RoutedEvent="Border.Loaded">
                <BeginStoryboard>
                    <Storyboard>
                        <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                         From="0" To="1" Duration="0:0:0.18">
                            <DoubleAnimation.EasingFunction>
                                <CubicEase EasingMode="EaseOut" />
                            </DoubleAnimation.EasingFunction>
                        </DoubleAnimation>
                        <DoubleAnimation Storyboard.TargetName="WindowScale"
                                         Storyboard.TargetProperty="ScaleX"
                                         From="0.94" To="1.0" Duration="0:0:0.20">
                            <DoubleAnimation.EasingFunction>
                                <BackEase EasingMode="EaseOut" Amplitude="0.25" />
                            </DoubleAnimation.EasingFunction>
                        </DoubleAnimation>
                        <DoubleAnimation Storyboard.TargetName="WindowScale"
                                         Storyboard.TargetProperty="ScaleY"
                                         From="0.94" To="1.0" Duration="0:0:0.20">
                            <DoubleAnimation.EasingFunction>
                                <BackEase EasingMode="EaseOut" Amplitude="0.25" />
                            </DoubleAnimation.EasingFunction>
                        </DoubleAnimation>
                    </Storyboard>
                </BeginStoryboard>
            </EventTrigger>
        </Border.Triggers>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Custom Title Bar with Minimize & Close Buttons -->
            <Border Grid.Row="0"
                    Background="{DynamicResource TitleBarBg}"
                    CornerRadius="8,8,0,0"
                    BorderBrush="{DynamicResource DialogBorder}"
                    BorderThickness="0,0,0,1"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid Height="34">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Title & Icon -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
                        <Path Width="14" Height="14" Fill="{DynamicResource AccentColor}" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center"
                              Data="M12,15.5A3.5,3.5 0 0,1 8.5,12A3.5,3.5 0 0,1 12,8.5A3.5,3.5 0 0,1 15.5,12A3.5,3.5 0 0,1 12,15.5M19.43,12.97C19.47,12.65 19.5,12.33 19.5,12C19.5,11.67 19.47,11.34 19.43,11L21.54,9.37C21.73,9.22 21.78,8.95 21.66,8.73L19.66,5.27C19.54,5.05 19.27,4.96 19.05,5.05L16.56,6.05C16.04,5.66 15.5,5.32 14.87,5.07L14.5,2.42C14.46,2.18 14.25,2 14,2H10C9.75,2 9.54,2.18 9.5,2.42L9.13,5.07C8.5,5.32 7.96,5.66 7.44,6.05L4.95,5.05C4.73,4.96 4.46,5.05 4.34,5.27L2.34,8.73C2.21,8.95 2.27,9.22 2.46,9.37L4.57,11C4.53,11.34 4.5,11.67 4.5,12C4.5,12.33 4.53,12.65 4.57,12.97L2.46,14.63C2.27,14.78 2.21,15.05 2.34,15.27L4.34,18.73C4.46,18.95 4.73,19.03 4.95,18.95L7.44,17.94C7.96,18.34 8.5,18.68 9.13,18.93L9.5,21.58C9.54,21.82 9.75,22 10,22H14C14.25,22 14.46,21.82 14.5,21.58L14.87,18.93C15.5,18.67 16.04,18.34 16.56,17.94L19.05,18.95C19.27,19.03 19.54,18.95 19.66,18.73L21.66,15.27C21.78,15.05 21.73,14.78 21.54,14.63L19.43,12.97Z" />
                        <TextBlock Text="Bookmark Bar Settings"
                                   FontSize="13" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimary}"
                                   VerticalAlignment="Center" />
                    </StackPanel>

                    <!-- Minimize and Close Buttons -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button Style="{StaticResource TitleBarButtonStyle}" Click="BtnMinimize_Click" ToolTip="Minimize">
                            <Path Width="10" Height="1" Fill="{DynamicResource TextSecondary}" Stretch="Fill"
                                  Data="M0,0 L10,0 Z" Stroke="{DynamicResource TextSecondary}" StrokeThickness="1.5" />
                        </Button>
                        <Button Style="{StaticResource CloseButtonStyle}" Click="BtnClose_Click" ToolTip="Close">
                            <Path Width="10" Height="10" Fill="Transparent" Stretch="Uniform"
                                  Stroke="{Binding Path=Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="1.5"
                                  Data="M0,0 L10,10 M10,0 L0,10" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Compact Settings Content -->
            <StackPanel Grid.Row="1" Margin="16,12,16,6">
                <!-- Appearance & Size Section -->
                <Border Background="{DynamicResource SectionBg}" CornerRadius="6" Padding="12,10" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="Appearance &amp; Bookmark Sizing"
                                   FontWeight="SemiBold" FontSize="12.5" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,6" />

                        <!-- Bar Height -->
                        <Grid Margin="0,2,0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Bookmark Bar Height" Foreground="{DynamicResource TextSecondary}" FontSize="12" />
                            <TextBlock x:Name="TxtBarHeightVal" Grid.Column="1" Text="32px" Foreground="{DynamicResource AccentColor}" FontWeight="Bold" FontSize="12" />
                        </Grid>
                        <Slider x:Name="SliderBarHeight" Minimum="24" Maximum="60" Value="32" ValueChanged="Slider_ValueChanged" />

                        <!-- Bookmark Spacing (Margin between items) -->
                        <Grid Margin="0,6,0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Bookmark Spacing (Margin between items)" Foreground="{DynamicResource TextSecondary}" FontSize="12" />
                            <TextBlock x:Name="TxtSpacingVal" Grid.Column="1" Text="2px" Foreground="{DynamicResource AccentColor}" FontWeight="Bold" FontSize="12" />
                        </Grid>
                        <Slider x:Name="SliderSpacing" Minimum="0" Maximum="16" Value="2" ValueChanged="Slider_ValueChanged" />

                        <!-- Bookmark Inner Padding -->
                        <Grid Margin="0,6,0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Bookmark Padding (Inner space)" Foreground="{DynamicResource TextSecondary}" FontSize="12" />
                            <TextBlock x:Name="TxtPaddingVal" Grid.Column="1" Text="8px" Foreground="{DynamicResource AccentColor}" FontWeight="Bold" FontSize="12" />
                        </Grid>
                        <Slider x:Name="SliderPadding" Minimum="2" Maximum="20" Value="8" ValueChanged="Slider_ValueChanged" />
                    </StackPanel>
                </Border>

                <!-- Startup Section -->
                <Border Background="{DynamicResource SectionBg}" CornerRadius="6" Padding="12,10" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="Startup Settings"
                                   FontWeight="SemiBold" FontSize="12.5" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,6" />

                        <CheckBox x:Name="ChkAutoStart" Content="Start automatically on Windows boot" />
                    </StackPanel>
                </Border>

                <!-- Shortcuts & Management -->
                <Border Background="{DynamicResource SectionBg}" CornerRadius="6" Padding="12,10" Margin="0,0,0,0">
                    <StackPanel>
                        <TextBlock Text="Shortcuts &amp; Management"
                                   FontWeight="SemiBold" FontSize="12.5" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,6" />

                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Path Width="12" Height="12" Fill="{DynamicResource AccentGold}" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center"
                                      Data="M12,2A7,7 0 0,0 5,9C5,11.38 6.19,13.47 8,14.74V17A1,1 0 0,0 9,18H15A1,1 0 0,0 16,17V14.74C17.81,13.47 19,11.38 19,9A7,7 0 0,0 12,2M9,21A1,1 0 0,0 10,22H14A1,1 0 0,0 15,21V20H9V21Z" />
                                <TextBlock Text="Toggle Bar: Ctrl + Shift + B" Foreground="{DynamicResource TextSecondary}" FontSize="11.5" VerticalAlignment="Center" />
                            </StackPanel>
                            <Button Grid.Column="1" Content="Reset Default Bookmarks" Style="{StaticResource FluentButton}" Click="BtnReset_Click" Padding="10,4" />
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- Actions Footer: Cancel, Apply, Save -->
            <Border Grid.Row="2" Background="{DynamicResource TitleBarBg}" CornerRadius="0,0,8,8" Padding="16,10,16,10" BorderBrush="{DynamicResource DialogBorder}" BorderThickness="0,1,0,0">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Cancel" Style="{StaticResource FluentButton}" Click="BtnCancel_Click" Margin="0,0,8,0" Width="80" />
                    <Button Content="Apply" Style="{StaticResource FluentButton}" Click="BtnApply_Click" Margin="0,0,8,0" Width="80" />
                    <Button Content="Save" Style="{StaticResource PrimaryButton}" Click="BtnSave_Click" Width="80" />
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
